# Higgsfield PAYG API credentials. Server-side only; never expose them to the browser.
# Use the two values shown once when you create an API key in the Higgsfield API console.
HF_API_KEY=
HF_API_SECRET=

# Optional backwards-compatible combined format: KEY_ID:KEY_SECRET
# If this is set, it takes precedence over the two values above.
HF_CREDENTIALS=

# Private token required by connector/admin operations.
# Generate a long random value and store it only in Vercel/server environments.
SCROLLSPRINT_CONNECTOR_TOKEN=

# Optional dedicated token for the MCP endpoint. If omitted, MCP falls back to
# SCROLLSPRINT_CONNECTOR_TOKEN. Prefer a separate token before wider distribution.
SCROLLSPRINT_MCP_TOKEN=

# Hard safety ceiling for a single MCP-triggered Higgsfield generation in USD.
# Defaults to 15.00 if omitted. The agent must also provide a lower/equal max_usd per call.
SCROLLSPRINT_MCP_MAX_SINGLE_GENERATION_USD=15

# WhatsApp destination, supplied once the business number is confirmed.
NEXT_PUBLIC_SCROLLSPRINT_WHATSAPP_URL=

# Server-only email settings. The sender belongs to your verified Resend domain.
RESEND_API_KEY=
SCROLLSPRINT_FROM_EMAIL=
SCROLLSPRINT_CONTACT_EMAIL=
